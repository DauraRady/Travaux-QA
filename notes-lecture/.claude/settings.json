{
  "permissions": {
    "allow": [
      "Bash(python3 .claude/skills/gherkin-test-generation/scripts/build_tc.py *)",
      "Bash(python .claude/skills/gherkin-test-generation/scripts/build_tc.py *)",
      "Bash(mkdir -p .qc-agent*)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(env)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.claude/settings.local.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde_ado.py\""
          }
        ]
      }
    ]
  }
}
